{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "exa": { "type": "remote", "url": "https://mcp.exa.ai/mcp", "oauth": false },
    "parallel": { "type": "remote", "url": "https://search.parallel.ai/mcp", "oauth": false },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": { "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}" }
    },
    "google": {
      "type": "local",
      "command": ["uvx", "workspace-mcp", "--permissions", "gmail:drafts"],
      "enabled": true,
      "environment": {
        "GOOGLE_OAUTH_CLIENT_ID": "{env:GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "{env:GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    }
  }
}
