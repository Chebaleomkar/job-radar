# Copy to .env (gitignored) or set these in your shell profile. All optional.
# Exa and Parallel work without keys (rate-limited). Add keys for higher limits.
EXA_API_KEY=
PARALLEL_API_KEY=
# Firecrawl: free plan at firecrawl.dev, no card. Leave empty to skip Firecrawl.
FIRECRAWL_API_KEY=
# Google OAuth desktop client for Gmail drafts (SETUP.md step 3). Leave empty to skip.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
